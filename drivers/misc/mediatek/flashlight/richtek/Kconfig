config RT_FLASHLIGHT
	bool "Richtek Flashlight Device Class"
	default n
	help
	  Say Y to enable Richtek Flashlight Device Class
	  This Framework is good for
	  controling flashlight Leds.
	  Say N to disable Richtek Flahslight Device Class


config POCKET_TORCH
	bool "Titan Pocket torch LED"
	depends on RT_FLASHLIGHT && MT6370_PMU_FLED && LEDS_CLASS
	help
	  Say Y for /sys/class/leds/torch, which lights both MT6370 flash
	  LEDs in torch mode at the stock torch currents (175 and 25 mA).
