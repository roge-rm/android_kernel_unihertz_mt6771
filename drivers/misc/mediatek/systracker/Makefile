# The AEE SRAM backtrace (backtrace_64bit.c) is left out: there's no AEE on 5.10,
# and the oops or panic that a timeout ends in prints the backtrace itself.
obj-$(CONFIG_MTK_SYSTRACKER_V2) += systracker_interface_v2.o
obj-$(CONFIG_MTK_SYSTRACKER_V2) += $(MTK_PLATFORM)/
