config MTK_SMARTPA_FS16XX_I2C
	bool "FourSemi FS16xx smart amp raw I2C device"
	depends on I2C
	help
	  /dev/smartpa_i2c on the mediatek,speaker_amp client for the
	  vendor FS16xx userspace library, as the stock foursemi driver.
	  Built in so the node exists before init's on boot chmod.
