config MTK_NET_CCMNI
	bool "MediaTek CCMNI driver"
	depends on NET
	default n
	select WIRELESS_EXT
	select WEXT_PRIV
	help
	  The ccmni network interfaces for the eccci modem driver. eccci's
	  port_net registers the interfaces through ccmni_ops.init; until
	  eccci is built, weak stubs stand in for the two port calls ccmni
	  makes back into it.
