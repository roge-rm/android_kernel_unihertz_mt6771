# The MT6370 line of T's pmic/Makefile. T's other PMIC directories and
# mtk_battery_adc_intf.o aren't ported.
obj-$(CONFIG_MFD_MT6370_PMU)    += mt6370/
# The legacy MT6358 PMIC calls (AUXADC, efuse, IRQ callbacks) over the 5.10 mt6397 MFD, for the
# codec and accdet.
obj-$(CONFIG_MTK_PMIC_CHIP_MT6358) += mt6358/
